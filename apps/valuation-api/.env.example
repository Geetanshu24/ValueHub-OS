# Server
PORT=3100
# Comma-separated list of allowed origins for CORS (the valuation web app)
CORS_ORIGINS=http://localhost:5174

# Dedicated Postgres database for ValueHub OS. Do not point this at the
# Valuer Connect database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/valuehub_os
# Used for migrations. Same as DATABASE_URL on a plain Postgres. On Supabase:
# DATABASE_URL is the pooled (port 6543, add ?pgbouncer=true&connection_limit=1)
# string and DIRECT_URL is the direct or session-pooler (port 5432) string.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/valuehub_os

# HS256 signing secret for access tokens, at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
# Access token lifetime (jsonwebtoken format: 15m, 8h, 1d)
JWT_EXPIRES_IN=8h

# Used only by `npm run db:seed` to create the first firm and admin.
SEED_FIRM_NAME=Demo Valuation Firm
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# File storage. With the two Supabase settings below set, files go to a private
# Supabase Storage bucket. Leave them empty to keep files on local disk.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=valuehub-files
# Local object storage root, used when Supabase is not configured.
STORAGE_DIR=./storage

# Outbound email for sending reports. Leave SMTP_HOST empty to disable the
# EMAIL channel; submissions can still be recorded under other channels.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Public URL of the web app, used in password-reset emails.
WEB_URL=http://localhost:5174

# Reading documents with AI (optional). With a key set, an uploaded document's text is sent to
# Anthropic's API to pick out the facts a bank report asks for; without one, only pattern matching runs.
ANTHROPIC_API_KEY=
# AI_EXTRACT_MODEL=claude-sonnet-5-5
# AI_EXTRACT=false

# Testing aid: skip mandatory-field and stage-gate checks. Never enable in production.
RELAX_CHECKS=false
