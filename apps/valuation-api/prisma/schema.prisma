// ValueHub Valuation Operating System — core data model.
// Separate from apps/api (Valuer Connect): own database, own client.
//
// Principles from the blueprint:
//  - Property is not the assignment: Property is the stable identity,
//    Assignment/Inspection/Valuation/Report are per-engagement records.
//  - Issued records are never overwritten: valuations and reports are
//    versioned rows, not edited in place.
//  - Extracted facts stay UNVERIFIED until a human reviews them.
//  - Every row is owned by a Firm (tenant); queries always filter by firmId.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// The app connects through DATABASE_URL (on Supabase, the pooled connection).
// Migrations use DIRECT_URL, a direct connection, because they need session
// features a transaction pooler does not give. On a plain Postgres, set both
// to the same address.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────── Enums ─────────────────────────
// Keep in sync with packages/valuation-shared.

enum UserRole {
  FIRM_ADMIN
  VALUER
  INSPECTOR
  REVIEWER
  ACCOUNTS
  DRAFTER
}

enum PropertyClass {
  FLAT
  HOUSE
  LAND
  COMMERCIAL
  INDUSTRIAL
  MIXED_USE
}

enum AssignmentStatus {
  INTAKE
  DOCUMENTS
  INSPECTION
  VALUATION
  QUALITY_REVIEW
  APPROVED
  SUBMITTED
  REVISION
  CLOSED
  CANCELLED
}

enum IntakeSource {
  WHATSAPP
  EMAIL
  MOBILE_APP
  DASHBOARD
  MANUAL
}

enum AssignmentPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DocumentType {
  BANK_INSTRUCTION
  SALE_DEED
  APPROVED_PLAN
  REVENUE_RECORD
  TAX_RECEIPT
  OCCUPATION_CERTIFICATE
  SHAJRA_PLAN
  WATER_BILL
  MAGISTRATE_CERTIFICATE
  PATWARI_REPORT
  LAYOUT_PLAN
  COMPLETION_CERTIFICATE
  ELECTRICITY_BILL
  PROPERTY_TAX
  REGISTRY_PAPERS
  MARKET_EVIDENCE
  CIRCLE_RATE_COPY
  OTHER
}

enum VerificationState {
  UNVERIFIED
  VERIFIED
  CORRECTED
  UNKNOWN
}

enum OcrStatus {
  NOT_RUN
  DONE
  NO_TEXT
  FAILED
}

enum FieldSource {
  MANUAL
  OCR
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  SUBMITTED
  REVIEWED
}

enum DiscrepancyStatus {
  UNRESOLVED
  RESOLVED
  DISCLOSED
  ESCALATED
}

enum VersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ISSUED
  SUPERSEDED
}

// How a line item relates to the adopted base rate, so the same item is
// never counted twice.
enum LineItemTreatment {
  INCLUDED_IN_BASE_RATE
  SEPARATELY_VALUED
  NOT_APPLICABLE
  REQUIRES_REVIEW
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum SubmissionChannel {
  EMAIL
  PORTAL
  COURIER
  HAND_DELIVERY
}

// RECORDED: a person logged it. SENT: the mail server accepted it (not proof
// of delivery). FAILED: the attempt errored.
enum DeliveryStatus {
  RECORDED
  SENT
  FAILED
}

enum QueryKind {
  QUERY
  REVISION_REQUEST
}

enum QueryStatus {
  OPEN
  RESPONDED
  CLOSED
}

// ───────────────────────── Tenancy & people ─────────────────────────

model Firm {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users               User[]
  banks               Bank[]
  branches            BankBranch[]
  properties          Property[]
  assignments         Assignment[]
  documents           Document[]
  extractedFields     ExtractedField[]
  inspections         Inspection[]
  discrepancies       Discrepancy[]
  comparables         MarketComparable[]
  valuations          ValuationVersion[]
  templates           ReportTemplate[]
  reports             ReportVersion[]
  submissions         Submission[]
  invoices            Invoice[]
  payments            Payment[]
  queries             BankQuery[]
  auditEvents         AuditEvent[]
  idSequences         IdSequence[]
  bankReportForms     BankReportForm[]
  marketRates         MarketRate[]
  reportChecks        ReportCheck[]
  comparisonDecisions ComparisonDecision[]
  reworkRequests      ReworkRequest[]
  finalReports        FinalReport[]
  reportSends         ReportSend[]
}

model User {
  id           String   @id @default(uuid())
  firmId       String
  email        String   @unique
  fullName     String
  role         UserRole
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  firm                   Firm           @relation(fields: [firmId], references: [id])
  assignmentsAsValuer    Assignment[]   @relation("AssignmentValuer")
  inspections            Inspection[]   @relation("InspectionInspector")
  assignmentsAsDrafter   Assignment[]   @relation("AssignmentDrafter")
  assignmentsAsInspector Assignment[]   @relation("AssignmentInspector")
  notifications          Notification[]

  @@index([firmId])
}

// Per-firm counters behind VH-PROP-000184 / VH-ASG-2026-00921 / invoices.
// Incremented atomically inside the creating transaction.
model IdSequence {
  firmId String
  key    String
  value  Int    @default(0)

  firm Firm @relation(fields: [firmId], references: [id])

  @@id([firmId, key])
}

// ───────────────────────── Clients ─────────────────────────

model Bank {
  id        String   @id @default(uuid())
  firmId    String
  name      String
  createdAt DateTime @default(now())

  firm        Firm             @relation(fields: [firmId], references: [id])
  branches    BankBranch[]
  assignments Assignment[]
  templates   ReportTemplate[]

  @@unique([firmId, name])
}

model BankBranch {
  id           String   @id @default(uuid())
  firmId       String
  bankId       String
  name         String
  city         String?
  district     String?
  state        String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())

  firm        Firm         @relation(fields: [firmId], references: [id])
  bank        Bank         @relation(fields: [bankId], references: [id])
  assignments Assignment[]

  @@unique([bankId, name])
  @@index([firmId])
}

// ───────────────────────── Property identity ─────────────────────────
// Stable across assignments. Holds identity only: never a value, a photo
// from one visit, or an area adopted for one report.

model Property {
  id            String        @id @default(uuid())
  firmId        String
  code          String // VH-PROP-000184
  propertyClass PropertyClass
  addressLine   String
  unitDetail    String? // unit / plot / floor
  locality      String?
  village       String?
  tehsil        String?
  district      String?
  state         String?
  pinCode       String?
  latitude      Decimal?      @db.Decimal(9, 6)
  longitude     Decimal?      @db.Decimal(9, 6)
  khasraNumbers String[]      @default([])
  boundaries    Json? // { north, south, east, west }
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  firm        Firm         @relation(fields: [firmId], references: [id])
  assignments Assignment[]
  documents   Document[]

  @@unique([firmId, code])
  @@index([firmId, district])
  @@index([firmId, pinCode])
}

// ───────────────────────── Assignment ─────────────────────────

model Assignment {
  id                  String             @id @default(uuid())
  firmId              String
  code                String // VH-ASG-2026-00921
  bankId              String
  branchId            String?
  propertyId          String
  purpose             String
  scope               String?
  valuationDate       DateTime           @db.Date
  dueDate             DateTime           @db.Date
  receivedAt          DateTime           @default(now())
  intakeSource        IntakeSource       @default(DASHBOARD)
  priority            AssignmentPriority @default(NORMAL)
  borrowerName        String?
  instructionDate     DateTime?          @db.Date
  // The earlier assignment this one was started from. Nothing is copied
  // silently; the link only records where the starting details came from.
  reusedFromId        String?
  // Intake details from the bank's instruction and the booking call.
  bankOfficerName     String?
  bankOfficerMobile   String?
  loanAccountNo       String?
  applicantFatherName String?
  applicantMobile     String?
  applicantEmail      String?
  billingArrangement  String?
  specialInstructions String?
  approxAreaSqm       Decimal?           @db.Decimal(14, 2)
  fee                 Decimal?           @db.Decimal(12, 2)
  status              AssignmentStatus   @default(INTAKE)
  assignedValuerId    String
  // The client who asked for the work, and the two people the valuer hands the case to.
  clientPhone         String?
  assignedDrafterId   String?
  assignedInspectorId String?
  // When the current valuer was given the case, and when they first opened the pop-up for it.
  assignedAt          DateTime           @default(now())
  acknowledgedAt      DateTime?
  // The valuer approved the report: the bill is raised and the report may go to the bank.
  reportSubmittedAt   DateTime?
  reportSubmittedById String?
  createdById         String
  closedAt            DateTime?
  retainUntil         DateTime?          @db.Date
  legalHold           Boolean            @default(false)
  legalHoldReason     String?
  legalHoldAt         DateTime?
  legalHoldById       String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  firm                Firm                 @relation(fields: [firmId], references: [id])
  bank                Bank                 @relation(fields: [bankId], references: [id])
  branch              BankBranch?          @relation(fields: [branchId], references: [id])
  property            Property             @relation(fields: [propertyId], references: [id])
  assignedValuer      User                 @relation("AssignmentValuer", fields: [assignedValuerId], references: [id])
  reusedFrom          Assignment?          @relation("AssignmentReuse", fields: [reusedFromId], references: [id])
  reusedBy            Assignment[]         @relation("AssignmentReuse")
  documents           Document[]
  inspections         Inspection[]
  discrepancies       Discrepancy[]
  comparables         MarketComparable[]
  valuations          ValuationVersion[]
  reports             ReportVersion[]
  bankReportForms     BankReportForm[]
  submissions         Submission[]
  invoices            Invoice[]
  queries             BankQuery[]
  assignedDrafter     User?                @relation("AssignmentDrafter", fields: [assignedDrafterId], references: [id])
  assignedInspector   User?                @relation("AssignmentInspector", fields: [assignedInspectorId], references: [id])
  reportChecks        ReportCheck[]
  reportSends         ReportSend[]
  comparisonDecisions ComparisonDecision[]
  reworkRequests      ReworkRequest[]
  finalReports        FinalReport[]

  @@unique([firmId, code])
  @@index([firmId, status])
  @@index([firmId, dueDate])
  @@index([firmId, bankId])
  @@index([propertyId])
  @@index([assignedValuerId])
}

// ───────────────────────── Documents & evidence ─────────────────────────

model Document {
  id           String       @id @default(uuid())
  firmId       String
  propertyId   String
  assignmentId String?
  type         DocumentType
  fileName     String
  mimeType     String
  sizeBytes    Int
  pageCount    Int?
  storageKey   String // object-storage key of the untouched original
  sha256       String // change-detection aid, not proof of authenticity
  source       IntakeSource @default(DASHBOARD)
  ocrStatus    OcrStatus    @default(NOT_RUN)
  ocrText      String? // text read from the file; searchable, never treated as verified
  ocrError     String?
  ocrAt        DateTime?
  uploadedById String
  uploadedAt   DateTime     @default(now())

  firm       Firm             @relation(fields: [firmId], references: [id])
  property   Property         @relation(fields: [propertyId], references: [id])
  assignment Assignment?      @relation(fields: [assignmentId], references: [id])
  fields     ExtractedField[]

  @@index([firmId, propertyId])
  @@index([assignmentId])
}

// A fact read from a document. Starts UNVERIFIED; OCR output is a suggestion.
model ExtractedField {
  id             String            @id @default(uuid())
  firmId         String
  documentId     String
  fieldKey       String // e.g. plot_area_sqm
  extractedValue String
  pageNumber     Int
  confidence     Decimal?          @db.Decimal(4, 3)
  source         FieldSource       @default(MANUAL)
  state          VerificationState @default(UNVERIFIED)
  verifiedValue  String?
  // The drafter chose this document's value as the one the report uses when documents disagree.
  useInReport    Boolean           @default(false)
  // Where in the document it was read, a note, the unit it was written in, and who typed it.
  note           String?
  unit           String? // SQM | SQYD | SQFT for area facts
  enteredById    String?
  reviewedById   String?
  reviewedAt     DateTime?

  firm     Firm     @relation(fields: [firmId], references: [id])
  document Document @relation(fields: [documentId], references: [id])

  @@index([documentId])
  @@index([firmId, state])
}

// ───────────────────────── Inspection ─────────────────────────

model Inspection {
  id           String           @id @default(uuid())
  firmId       String
  assignmentId String
  inspectorId  String
  visitedAt    DateTime
  latitude     Decimal?         @db.Decimal(9, 6)
  longitude    Decimal?         @db.Decimal(9, 6)
  observations Json?
  status       InspectionStatus @default(SCHEDULED)
  createdAt    DateTime         @default(now())

  firm         Firm                    @relation(fields: [firmId], references: [id])
  assignment   Assignment              @relation(fields: [assignmentId], references: [id])
  inspector    User                    @relation("InspectionInspector", fields: [inspectorId], references: [id])
  measurements InspectionMeasurement[]
  photos       InspectionPhoto[]

  @@index([firmId, assignmentId])
  @@index([inspectorId])
}

model InspectionMeasurement {
  id           String  @id @default(uuid())
  inspectionId String
  label        String // e.g. "Plot", "Ground floor"
  fieldKey     String? // the documented fact this measures, e.g. plot_area_sqm
  areaSqm      Decimal @db.Decimal(12, 2)
  method       String // how it was measured
  note         String?

  inspection Inspection @relation(fields: [inspectionId], references: [id])

  @@index([inspectionId])
}

model InspectionPhoto {
  id               String    @id @default(uuid())
  inspectionId     String
  storageKey       String
  mimeType         String
  sha256           String
  caption          String?
  category         String? // front elevation, interior, boundary…
  captionConfirmed Boolean   @default(false)
  takenAt          DateTime?

  inspection Inspection @relation(fields: [inspectionId], references: [id])

  @@index([inspectionId])
}

// Two sources disagree. Both values are kept; the system never picks one.
model Discrepancy {
  id             String            @id @default(uuid())
  firmId         String
  assignmentId   String
  fieldKey       String // e.g. plot_area_sqm
  description    String
  valueA         String
  sourceA        String
  valueB         String
  sourceB        String
  material       Boolean           @default(true)
  status         DiscrepancyStatus @default(UNRESOLVED)
  resolutionNote String?
  // The standard treatment the valuer chose (see TREATMENTS in the shared package), if any.
  treatment      String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())

  firm       Firm       @relation(fields: [firmId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])

  @@index([assignmentId, status])
  @@index([firmId, status])
}

// ───────────────────────── Valuation ─────────────────────────

model MarketComparable {
  id            String   @id @default(uuid())
  firmId        String
  assignmentId  String
  location      String
  source        String
  isTransaction Boolean // false = asking price
  observedOn    DateTime @db.Date
  areaBasis     String
  ratePerSqm    Decimal  @db.Decimal(14, 2)
  adjustments   Json?
  verified      Boolean  @default(false)
  relevanceNote String?
  recordedById  String
  createdAt     DateTime @default(now())

  firm       Firm       @relation(fields: [firmId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])

  @@index([assignmentId])
}

// Append-only: a change creates versionNumber + 1, never edits an approved row.
model ValuationVersion {
  id                String        @id @default(uuid())
  firmId            String
  assignmentId      String
  versionNumber     Int
  status            VersionStatus @default(DRAFT)
  method            String
  engineVersion     String
  areaBasis         String
  adoptedAreaSqm    Decimal       @db.Decimal(12, 2)
  adoptedAreaSource String // why this area was adopted over other records
  inputs            Json // exact engine input, so the version can be recomputed
  assumptions       String?
  totalValue        Decimal       @db.Decimal(16, 2)
  changeReason      String? // required from V2 onwards
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime      @default(now())

  firm       Firm                @relation(fields: [firmId], references: [id])
  assignment Assignment          @relation(fields: [assignmentId], references: [id])
  lineItems  ValuationLineItem[]
  reports    ReportVersion[]

  @@unique([assignmentId, versionNumber])
  @@index([firmId])
}

model ValuationLineItem {
  id                 String            @id @default(uuid())
  valuationVersionId String
  sortOrder          Int
  component          String // Land, Ground floor, Lift ...
  // Area lines: amount = quantity x rate. Percentage lines (depreciation,
  // adjustments): unit is '%', rate is the base amount, amount = rate x quantity / 100.
  quantity           Decimal           @db.Decimal(14, 2)
  unit               String
  rate               Decimal           @db.Decimal(14, 2)
  amount             Decimal           @db.Decimal(16, 2)
  treatment          LineItemTreatment @default(REQUIRES_REVIEW)
  sourceNote         String? // comparable, observation or assumption relied on
  overrideReason     String? // mandatory for any manual override

  valuationVersion ValuationVersion @relation(fields: [valuationVersionId], references: [id])

  @@index([valuationVersionId])
}

// ───────────────────────── Reports ─────────────────────────

model ReportTemplate {
  id            String         @id @default(uuid())
  firmId        String
  bankId        String?
  name          String
  propertyClass PropertyClass?
  version       Int
  effectiveFrom DateTime       @db.Date
  fieldMap      Json // the template spec: sections, fields -> source paths, limitations, annexures
  isActive      Boolean        @default(true)
  createdById   String
  createdAt     DateTime       @default(now())

  firm    Firm            @relation(fields: [firmId], references: [id])
  bank    Bank?           @relation(fields: [bankId], references: [id])
  reports ReportVersion[]

  @@unique([firmId, name, version])
  @@index([firmId, bankId, propertyClass])
}

model ReportVersion {
  id                 String        @id @default(uuid())
  firmId             String
  assignmentId       String
  valuationVersionId String
  templateId         String
  versionNumber      Int
  status             VersionStatus @default(DRAFT)
  // Everything the PDF is drawn from, frozen at creation, so a report can be
  // regenerated later without reading live data.
  snapshot           Json
  qc                 Json
  storageKey         String // current PDF: draft, then the final issued copy
  sha256             String
  // Set when the report is the bank's own layout (BOI, PNB, SBI): the Word copy is kept beside the PDF.
  bankFormat         String?
  docxKey            String?
  docxSha256         String?
  createdById        String
  changeReason       String? // required when a version follows an issued one
  reviewerId         String?
  approvedAt         DateTime?
  issuedById         String?
  issuedAt           DateTime?
  createdAt          DateTime      @default(now())

  firm             Firm             @relation(fields: [firmId], references: [id])
  assignment       Assignment       @relation(fields: [assignmentId], references: [id])
  valuationVersion ValuationVersion @relation(fields: [valuationVersionId], references: [id])
  template         ReportTemplate   @relation(fields: [templateId], references: [id])
  submissions      Submission[]

  @@unique([assignmentId, versionNumber])
  @@index([firmId])
}

model Submission {
  id              String            @id @default(uuid())
  firmId          String
  assignmentId    String
  reportVersionId String
  channel         SubmissionChannel
  recipient       String
  sentAt          DateTime
  sentById        String
  deliveryStatus  DeliveryStatus    @default(RECORDED)
  deliveryError   String?
  messageId       String?
  acknowledgedAt  DateTime?
  note            String?

  firm          Firm          @relation(fields: [firmId], references: [id])
  assignment    Assignment    @relation(fields: [assignmentId], references: [id])
  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id])

  @@index([assignmentId])
}

// ───────────────────────── Accounts ─────────────────────────

model Invoice {
  id           String        @id @default(uuid())
  firmId       String
  assignmentId String
  code         String // VH-INV-0041
  amount       Decimal       @db.Decimal(12, 2)
  issuedOn     DateTime      @db.Date
  dueOn        DateTime      @db.Date
  status       InvoiceStatus @default(DRAFT)
  sentAt       DateTime?
  cancelReason String?
  notes        String?
  createdById  String
  createdAt    DateTime      @default(now())

  firm       Firm              @relation(fields: [firmId], references: [id])
  assignment Assignment        @relation(fields: [assignmentId], references: [id])
  payments   Payment[]
  followUps  InvoiceFollowUp[]

  @@unique([firmId, code])
  @@index([firmId, status, dueOn])
  @@index([assignmentId])
}

// Payments are never edited or deleted; a mistake is voided with a reason.
model Payment {
  id           String    @id @default(uuid())
  firmId       String
  invoiceId    String
  amount       Decimal   @db.Decimal(12, 2)
  receivedOn   DateTime  @db.Date
  reference    String?
  recordedById String
  voidedAt     DateTime?
  voidedById   String?
  voidReason   String?
  createdAt    DateTime  @default(now())

  firm    Firm    @relation(fields: [firmId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

enum FollowUpChannel {
  EMAIL
  CALL
  VISIT
  OTHER
}

// History of chasing an invoice: who contacted whom, how, and what was agreed.
model InvoiceFollowUp {
  id           String          @id @default(uuid())
  firmId       String
  invoiceId    String
  channel      FollowUpChannel
  note         String
  contactedAt  DateTime        @default(now())
  nextActionOn DateTime?       @db.Date
  sentTo       String?
  delivery     DeliveryStatus?
  createdById  String

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model BankQuery {
  id               String          @id @default(uuid())
  firmId           String
  assignmentId     String
  code             String // Q-2026-00003
  kind             QueryKind       @default(QUERY)
  question         String
  receivedAt       DateTime        @default(now())
  dueAt            DateTime
  status           QueryStatus     @default(OPEN)
  // What the response relied on: [{ type, id, note }]
  evidence         Json?
  response         String?
  respondedAt      DateTime?
  respondedById    String?
  responseSentTo   String?
  responseDelivery DeliveryStatus?
  escalatedAt      DateTime?
  escalatedById    String?
  escalationNote   String?
  createdById      String
  createdAt        DateTime        @default(now())

  firm       Firm       @relation(fields: [firmId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])

  @@unique([firmId, code])
  @@index([firmId, status, dueAt])
  @@index([assignmentId])
}

// ───────────────────────── Firm configuration

// One row per firm. retentionYears is deliberately empty until an admin sets
// it from the applicable law and bank agreements; the system supplies no default.
model FirmSettings {
  firmId         String   @id
  retentionYears Int?
  updatedById    String
  updatedAt      DateTime @updatedAt
}

// Default fee for new assignments. The most specific effective rule wins:
// bank + class, then bank, then class, then neither.
model FeeRule {
  id            String         @id @default(uuid())
  firmId        String
  bankId        String?
  propertyClass PropertyClass?
  amount        Decimal        @db.Decimal(12, 2)
  effectiveFrom DateTime       @db.Date
  createdById   String
  createdAt     DateTime       @default(now())

  @@index([firmId, bankId, propertyClass])
}

// Firm-defined sign-off items a reviewer must tick before a report is approved.
model ChecklistItem {
  id            String         @id @default(uuid())
  firmId        String
  label         String
  propertyClass PropertyClass? // null = applies to every class
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())

  responses ReportChecklistResponse[]

  @@index([firmId, isActive])
}

model ReportChecklistResponse {
  id              String   @id @default(uuid())
  firmId          String
  reportVersionId String
  itemId          String
  label           String // copied, so the record survives later edits to the item
  checked         Boolean
  note            String?
  checkedById     String
  checkedAt       DateTime @default(now())

  item ChecklistItem @relation(fields: [itemId], references: [id])

  @@unique([reportVersionId, itemId])
}

// One-time password reset links. Only a hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ───────────────────────── Audit ─────────────────────────

// A message shown to one user as a pop-up when they next open the app (e.g. a case was assigned).
model Notification {
  id           String    @id @default(uuid())
  firmId       String
  userId       String
  assignmentId String?
  kind         String // ASSIGNED | REASSIGNED
  title        String
  body         String
  createdAt    DateTime  @default(now())
  seenAt       DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, seenAt])
  @@index([firmId, assignmentId])
}

model AuditEvent {
  id         String   @id @default(uuid())
  firmId     String
  actorId    String?
  entityType String
  entityId   String
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())

  firm Firm @relation(fields: [firmId], references: [id])

  @@index([firmId, entityType, entityId])
  @@index([firmId, createdAt])
}

// The valuer's answers for a bank's own report format (e.g. Bank of India), keyed by the
// format's field keys. Separate from versioned reports: this is the working copy.
model BankReportForm {
  id           String   @id @default(uuid())
  firmId       String
  assignmentId String
  format       String
  values       Json
  updatedById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  firm       Firm       @relation(fields: [firmId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])

  @@unique([assignmentId, format])
  @@index([firmId])
}

// The firm's own record of what property is selling or being offered for, kept across assignments.
// Private to the firm: nothing here is shared or sent anywhere.
model MarketRate {
  id            String        @id @default(uuid())
  firmId        String
  locality      String // the micro-market, e.g. "Sector 14, Faridabad"
  propertyClass PropertyClass
  kind          String // TRANSACTION | ASKING | CIRCLE
  rate          Decimal       @db.Decimal(14, 2) // as quoted, per `unit`
  unit          String // SQ_FT | SQ_YD | SQ_M
  ratePerSqm    Decimal       @db.Decimal(14, 2) // the same rate per sq m, to compare like with like
  rateLow       Decimal?      @db.Decimal(14, 2) // the range seen, per `unit`, when the source gave one
  rateHigh      Decimal?      @db.Decimal(14, 2)
  observedOn    DateTime      @db.Date
  source        String // dealer, website, registry ...
  detail        String? // size, floor, contact, anything that explains the rate
  recordedById  String
  createdAt     DateTime      @default(now())

  firm Firm @relation(fields: [firmId], references: [id])

  @@index([firmId, locality])
  @@index([firmId, observedOn])
}

// The valuer's tick beside each key item of the report before approving it.
model ReportCheck {
  id           String   @id @default(uuid())
  firmId       String
  assignmentId String
  itemKey      String // owner, address, boundary_east … market_evidence
  checked      Boolean  @default(false)
  note         String?
  checkedById  String
  checkedAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  firm       Firm       @relation(fields: [firmId], references: [id])

  @@unique([assignmentId, itemKey])
  @@index([firmId])
}

// A record that the report went to the bank (or that the valuer sent it themselves).
model ReportSend {
  id             String         @id @default(uuid())
  firmId         String
  assignmentId   String
  format         String // BOI | PNB | SBI
  channel        String // EMAIL | WHATSAPP | OTHER
  recipient      String
  note           String?
  invoiceId      String?
  deliveryStatus DeliveryStatus @default(RECORDED)
  deliveryError  String?
  sentById       String
  sentAt         DateTime       @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  firm       Firm       @relation(fields: [firmId], references: [id])

  @@index([assignmentId])
  @@index([firmId])
}

// What a person decided about a difference between the documents and the site. Nothing is decided by the system.
model ComparisonDecision {
  id            String   @id @default(uuid())
  firmId        String
  assignmentId  String
  factKey       String
  outcome       String // DOCUMENT_CORRECT | SITE_CORRECT | EXPLAINED | NOT_APPLICABLE | NOT_AVAILABLE
  reason        String
  documentValue String
  siteValue     String
  decidedById   String
  decidedAt     DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  firm       Firm       @relation(fields: [firmId], references: [id])

  @@unique([assignmentId, factKey])
  @@index([firmId])
}

// The valuer sending work back: to the drafter, for a new site visit, or for more documents.
model ReworkRequest {
  id            String    @id @default(uuid())
  firmId        String
  assignmentId  String
  kind          String // DRAFTER | REINSPECTION | DOCUMENTS
  reason        String
  dueDate       DateTime? @db.Date
  assignedToId  String
  requestedById String
  revision      Int
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
  resolvedById  String?

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  firm       Firm       @relation(fields: [firmId], references: [id])

  @@index([assignmentId, resolvedAt])
  @@index([firmId])
}

// The report as approved: a stored PDF with its number, revision and the approval (signature) record.
model FinalReport {
  id           String   @id @default(uuid())
  firmId       String
  assignmentId String
  reportNumber String
  revision     Int
  format       String // BOI | PNB | SBI
  fileName     String
  storageKey   String
  sha256       String
  sizeBytes    Int
  approvedById String
  approvedAt   DateTime @default(now())
  signature    Json

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  firm       Firm       @relation(fields: [firmId], references: [id])

  @@unique([firmId, reportNumber])
  @@index([assignmentId])
}
