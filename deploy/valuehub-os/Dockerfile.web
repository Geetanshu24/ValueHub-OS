# Build from the project root:  docker build -f deploy/valuehub-os/Dockerfile.web --build-arg VITE_API_URL=https://api.example.com/api/v1 -t valuehub-web .
FROM node:24-slim AS build
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
WORKDIR /repo
COPY package.json package-lock.json ./
COPY packages packages
COPY apps/valuation-web apps/valuation-web
COPY apps/valuation-api/package.json apps/valuation-api/package.json
RUN npm ci --ignore-scripts \
 && npm run build --workspace packages/valuation-shared \
 && npm run build --workspace apps/valuation-web

FROM nginx:1.27-alpine
COPY --from=build /repo/apps/valuation-web/dist /usr/share/nginx/html
# Single-page app: unknown paths serve index.html.
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  location / { try_files $uri /index.html; }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
